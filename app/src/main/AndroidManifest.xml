    <application android:theme="@style/Theme.Qubat" android:label="QUBAT EV" android:icon="@drawable/ic_qubat" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
